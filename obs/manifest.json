{
  "id": "obs",
  "name": "Stream Control",
  "author": "LibreShard",
  "version": "1.1.1",
  "minAppVersion": "0.5.1",
  "icon": "🎬",
  "description": "Record, stream, save replays, mute audio and switch scenes in OBS Studio, with any app in front",
  "license": "Apache-2.0",
  "url": "https://github.com/libreshard/gallery-shards/tree/main/obs",
  "settings": [
    {
      "id": "keys",
      "type": "select",
      "default": "auto",
      "label": {
        "en": "Key set",
        "es": "Juego de teclas",
        "fr": "Jeu de touches",
        "pt": "Conjunto de teclas"
      },
      "options": [
        {
          "value": "auto",
          "label": {
            "en": "Automatic (by system)",
            "es": "Automático (según el sistema)",
            "fr": "Automatique (selon le système)",
            "pt": "Automático (pelo sistema)"
          }
        },
        {
          "value": "windows",
          "label": {
            "en": "Windows (F18…F22, Shift+Alt+F13…F18)",
            "es": "Windows (F18…F22, Mayús+Alt+F13…F18)",
            "fr": "Windows (F18…F22, Maj+Alt+F13…F18)",
            "pt": "Windows (F18…F22, Shift+Alt+F13…F18)"
          }
        },
        {
          "value": "linux",
          "label": {
            "en": "Linux (F7…F11, Shift+Alt+F1…F12)",
            "es": "Linux (F7…F11, Mayús+Alt+F1…F12)",
            "fr": "Linux (F7…F11, Maj+Alt+F1…F12)",
            "pt": "Linux (F7…F11, Shift+Alt+F1…F12)"
          }
        }
      ]
    },
    {
      "id": "scenes",
      "type": "number",
      "default": 4,
      "min": 0,
      "max": 6,
      "step": 1,
      "label": {
        "en": "Scene buttons",
        "es": "Botones de escena",
        "fr": "Boutons de scène",
        "pt": "Botões de cena"
      }
    },
    {
      "id": "scene1",
      "type": "text",
      "maxLength": 24,
      "default": "",
      "label": {
        "en": "Scene 1 name",
        "es": "Nombre de la escena 1",
        "fr": "Nom de la scène 1",
        "pt": "Nome da cena 1"
      }
    },
    {
      "id": "scene2",
      "type": "text",
      "maxLength": 24,
      "default": "",
      "label": {
        "en": "Scene 2 name",
        "es": "Nombre de la escena 2",
        "fr": "Nom de la scène 2",
        "pt": "Nome da cena 2"
      }
    },
    {
      "id": "scene3",
      "type": "text",
      "maxLength": 24,
      "default": "",
      "label": {
        "en": "Scene 3 name",
        "es": "Nombre de la escena 3",
        "fr": "Nom de la scène 3",
        "pt": "Nome da cena 3"
      }
    },
    {
      "id": "scene4",
      "type": "text",
      "maxLength": 24,
      "default": "",
      "label": {
        "en": "Scene 4 name",
        "es": "Nombre de la escena 4",
        "fr": "Nom de la scène 4",
        "pt": "Nome da cena 4"
      }
    },
    {
      "id": "scene5",
      "type": "text",
      "maxLength": 24,
      "default": "",
      "label": {
        "en": "Scene 5 name",
        "es": "Nombre de la escena 5",
        "fr": "Nom de la scène 5",
        "pt": "Nome da cena 5"
      }
    },
    {
      "id": "scene6",
      "type": "text",
      "maxLength": 24,
      "default": "",
      "label": {
        "en": "Scene 6 name",
        "es": "Nombre de la escena 6",
        "fr": "Nom de la scène 6",
        "pt": "Nome da cena 6"
      }
    }
  ],
  "permissions": {
    "keys": [
      "ctrl+shift+f18",
      "ctrl+shift+f19",
      "ctrl+shift+f20",
      "ctrl+shift+f21",
      "ctrl+shift+f22",
      "shift+alt+f13",
      "shift+alt+f14",
      "shift+alt+f15",
      "shift+alt+f16",
      "shift+alt+f17",
      "shift+alt+f18",
      "ctrl+shift+f7",
      "ctrl+shift+f8",
      "ctrl+shift+f9",
      "ctrl+shift+f10",
      "ctrl+shift+f11",
      "shift+alt+f1",
      "shift+alt+f3",
      "shift+alt+f5",
      "shift+alt+f9",
      "shift+alt+f11",
      "shift+alt+f12"
    ]
  }
}
